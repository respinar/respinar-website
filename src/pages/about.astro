---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Respinar"
  description="Learn more about Hamid Peywasti — Freelance Web Developer based in Iran."
>
  <section class="max-w-4xl mx-auto px-4 py-24">
    <div class="text-center mb-16">
      <p class="text-brand-primary font-semibold tracking-wide uppercase text-sm mb-3">About</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6">About Us</h1>
      <p class="text-lg text-brand-muted max-w-2xl mx-auto leading-relaxed">
        We are a passionate team focused on building modern, fast, and
        user-friendly web experiences. Our mission is to deliver clean, efficient,
        and scalable solutions for every project.
      </p>
    </div>

    <div class="h-px bg-brand-border mb-16"></div>

    <div class="grid md:grid-cols-2 gap-12 items-center mb-20">
      <div>
        <img src="/images/about.jpg" alt="About Image" class="rounded-2xl border border-brand-border w-full" />
      </div>
      <div class="space-y-6">
        <h2 class="text-2xl font-bold">Who We Are</h2>
        <p class="text-brand-muted leading-relaxed">
          We specialize in crafting high-quality digital products using the
          latest technologies. With expertise in Astro, Tailwind CSS, PHP,
          Contao CMS, and JavaScript frameworks, we bring both experience and
          creativity to every project.
        </p>
      </div>
    </div>

    <div class="bg-brand-surface border border-brand-border rounded-2xl p-8 md:p-12 mb-16">
      <h2 class="text-2xl font-bold mb-6">Our Values</h2>
      <ul class="grid sm:grid-cols-2 gap-4">
        <li class="flex items-start gap-3">
          <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-primary shrink-0"></span>
          <span class="text-brand-muted">Clean & maintainable code</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-primary shrink-0"></span>
          <span class="text-brand-muted">Fast performance</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-primary shrink-0"></span>
          <span class="text-brand-muted">SEO-optimized development</span>
        </li>
        <li class="flex items-start gap-3">
          <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-primary shrink-0"></span>
          <span class="text-brand-muted">User-focused design</span>
        </li>
      </ul>
    </div>

    <div class="text-center">
      <a href="/contact" class="inline-block bg-brand-primary text-white px-10 py-4 rounded-full text-lg font-semibold hover:brightness-110 transition">
        Contact Us
      </a>
    </div>
  </section>
</BaseLayout>
