---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Respinar | Freelance Web Developer"
  description="Respinar - Freelance Web Developer creating modern, fast, and SEO-friendly websites."
>
  <!-- HERO -->
  <section class="px-4 pt-20 pb-28 max-w-5xl mx-auto text-center">
    <p class="text-brand-primary font-semibold tracking-wide uppercase text-sm mb-4">
      Freelance Web Developer
    </p>
    <h1 class="text-5xl md:text-7xl font-extrabold leading-[1.1] tracking-tight mb-6">
      Crafting Digital<br />
      <span class="text-brand-primary">Experiences</span>
    </h1>
    <p class="text-lg text-brand-muted max-w-2xl mx-auto mb-10">
      I build high-performance websites using Astro, Tailwind CSS, PHP,
      JavaScript, and SEO-optimized development practices. Clean code, fast
      loading, professional results.
    </p>

    <div class="flex justify-center gap-4">
      <a
        href="/contact"
        class="bg-brand-primary text-white px-8 py-3.5 rounded-full text-lg font-semibold hover:brightness-110 transition"
      >
        Start a Project
      </a>
      <a
        href="/projects"
        class="border border-brand-border text-brand-muted px-8 py-3.5 rounded-full text-lg font-semibold hover:border-brand-primary hover:text-brand-primary transition"
      >
        View Work
      </a>
    </div>
  </section>

  <!-- FEATURED SERVICES -->
  <section class="px-4 py-24 bg-brand-surface border-y border-brand-border">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">What I Do</h2>
      <p class="text-brand-muted text-center max-w-xl mx-auto mb-16">
        End-to-end web development services focused on performance, design, and scalability.
      </p>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="group bg-brand-bg border border-brand-border p-8 rounded-2xl hover:border-brand-primary/40 transition">
          <div class="w-12 h-12 rounded-xl bg-brand-secondary/30 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Web Development</h3>
          <p class="text-brand-muted leading-relaxed">
            Building modern, fast, scalable websites using Astro, JavaScript,
            PHP, and Tailwind CSS — fully optimized and SEO-friendly.
          </p>
        </div>

        <div class="group bg-brand-bg border border-brand-border p-8 rounded-2xl hover:border-brand-primary/40 transition">
          <div class="w-12 h-12 rounded-xl bg-brand-secondary/30 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0A2.25 2.25 0 0121 12v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6c0-.98.626-1.813 1.5-2.122"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Contao CMS</h3>
          <p class="text-brand-muted leading-relaxed">
            Creating custom Contao 5 modules, content elements, and extensions
            with a clean architecture and long-term maintainability.
          </p>
        </div>

        <div class="group bg-brand-bg border border-brand-border p-8 rounded-2xl hover:border-brand-primary/40 transition">
          <div class="w-12 h-12 rounded-xl bg-brand-secondary/30 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
            </svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">SEO & Performance</h3>
          <p class="text-brand-muted leading-relaxed">
            Technical SEO, schema markup, optimized meta descriptions, and speed
            improvements for better ranking and user experience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT PREVIEW -->
  <section class="px-4 py-24 max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
    <img src="/images/about.jpg" alt="About Me" class="rounded-2xl border border-brand-border" />
    <div>
      <p class="text-brand-primary font-semibold tracking-wide uppercase text-sm mb-2">About Me</p>
      <h2 class="text-3xl md:text-4xl font-bold mb-6">15+ Years of Building the Web</h2>
      <p class="text-brand-muted mb-4 leading-relaxed">
        I'm a web developer with over 15 years of experience building websites,
        CMS modules, and high-performance applications. I focus on clean code,
        speed, and professional user experience.
      </p>
      <p class="text-brand-muted mb-8 leading-relaxed">
        I use Astro, JavaScript, PHP, Contao CMS, Linux, and modern development
        tools to build maintainable and scalable projects.
      </p>
      <a href="/about" class="inline-flex items-center gap-2 text-brand-primary font-semibold hover:underline underline-offset-4 transition">
        Read More
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- CALL TO ACTION -->
  <section class="px-4 py-24 bg-brand-surface border-y border-brand-border text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Have a Project in Mind?</h2>
      <p class="text-brand-muted text-lg mb-10">
        Let's build something great together. Fast, modern, SEO-optimized, and ready for growth.
      </p>
      <a href="/contact" class="inline-block bg-brand-primary text-white px-10 py-4 rounded-full text-lg font-semibold hover:brightness-110 transition">
        Get In Touch
      </a>
    </div>
  </section>
</BaseLayout>
