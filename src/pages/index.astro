---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Respinar | Freelance Web Developer"
  description="Respinar - Freelance Web Developer creating modern, fast, and SEO-friendly websites."
>
  <!-- HERO -->
  <section id="top" class="px-4 min-h-[70vh] flex items-center justify-center text-center">
    <div class="max-w-3xl">
      <p class="text-brand-primary font-medium tracking-widest uppercase text-sm mb-4">Freelance Web Developer</p>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6">
        Hamid Peywasti
      </h1>
      <p class="text-lg text-brand-muted max-w-xl mx-auto mb-10 leading-relaxed">
        I build fast, modern websites with Astro, Tailwind, PHP, and JavaScript.
      </p>
      <div class="flex justify-center gap-4">
        <a href="#contact" class="bg-brand-primary text-white px-8 py-3 rounded-full font-semibold hover:brightness-110 transition">Get in Touch</a>
        <a href="#projects" class="border border-brand-border text-brand-muted px-8 py-3 rounded-full font-semibold hover:border-brand-primary hover:text-brand-primary transition">View Work</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="px-4 py-24 max-w-3xl mx-auto text-center">
    <p class="text-brand-primary font-medium tracking-widest uppercase text-sm mb-3">About</p>
    <h2 class="text-3xl font-bold mb-6">15+ Years of Building the Web</h2>
    <p class="text-brand-muted leading-relaxed">
      I'm a web developer with over 15 years of experience building websites, CMS modules, and high-performance applications. I focus on clean code, speed, and professional user experience using Astro, JavaScript, PHP, Contao CMS, and modern development tools.
    </p>
  </section>

  <div class="h-px bg-brand-border max-w-5xl mx-auto"></div>

  <!-- PROJECTS -->
  <section id="projects" class="px-4 py-24 max-w-5xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-brand-primary font-medium tracking-widest uppercase text-sm mb-3">Selected Work</p>
      <h2 class="text-3xl font-bold">Projects</h2>
    </div>

    <div class="space-y-6">
      <!-- Project 1 -->
      <a href="#" class="group block bg-brand-bg border border-brand-border p-6 md:p-8 rounded-2xl hover:border-brand-primary/30 transition">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
          <h3 class="text-xl font-bold group-hover:text-brand-primary transition">E-commerce Platform</h3>
          <span class="text-xs text-brand-muted font-medium">Astro · Tailwind · JavaScript</span>
        </div>
        <p class="text-brand-muted text-sm">Modern e-commerce solution built with Astro and Tailwind CSS, featuring fast loading and SEO optimization.</p>
      </a>

      <!-- Project 2 -->
      <a href="#" class="group block bg-brand-bg border border-brand-border p-6 md:p-8 rounded-2xl hover:border-brand-primary/30 transition">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
          <h3 class="text-xl font-bold group-hover:text-brand-primary transition">Contao CMS Extension</h3>
          <span class="text-xs text-brand-muted font-medium">PHP · Contao · MySQL</span>
        </div>
        <p class="text-brand-muted text-sm">Custom Contao 5 module for content management with advanced features and clean architecture.</p>
      </a>

      <!-- Project 3 -->
      <a href="#" class="group block bg-brand-bg border border-brand-border p-6 md:p-8 rounded-2xl hover:border-brand-primary/30 transition">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
          <h3 class="text-xl font-bold group-hover:text-brand-primary transition">SEO-Optimized Blog</h3>
          <span class="text-xs text-brand-muted font-medium">Astro · Tailwind · SEO</span>
        </div>
        <p class="text-brand-muted text-sm">High-performance blog with technical SEO, schema markup, and optimized loading speeds.</p>
      </a>
    </div>
  </section>

  <div class="h-px bg-brand-border max-w-5xl mx-auto"></div>

  <!-- CONTACT -->
  <section id="contact" class="px-4 py-24 max-w-3xl mx-auto text-center">
    <p class="text-brand-primary font-medium tracking-widest uppercase text-sm mb-3">Contact</p>
    <h2 class="text-3xl font-bold mb-6">Let's Work Together</h2>
    <p class="text-brand-muted mb-10">Have a project in mind? I'd love to hear from you.</p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="mailto:info@respinar.com" class="inline-flex items-center justify-center gap-3 bg-brand-surface border border-brand-border px-6 py-3 rounded-xl hover:border-brand-primary transition">
        <svg class="w-5 h-5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
        </svg>
        <span class="text-sm font-medium">info@respinar.com</span>
      </a>
      <a href="tel:+989142553221" class="inline-flex items-center justify-center gap-3 bg-brand-surface border border-brand-border px-6 py-3 rounded-xl hover:border-brand-primary transition">
        <svg class="w-5 h-5 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
        </svg>
        <span class="text-sm font-medium">+98 914 255 3221</span>
      </a>
    </div>
  </section>
</BaseLayout>
