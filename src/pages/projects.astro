---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects | Respinar"
  description="Explore my portfolio of web development projects including Astro, Tailwind CSS, and Contao CMS solutions."
>
  <section class="px-4 pt-20 pb-12 max-w-5xl mx-auto text-center">
    <p class="text-brand-primary font-semibold tracking-wide uppercase text-sm mb-3">Portfolio</p>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6">My Projects</h1>
    <p class="text-lg text-brand-muted max-w-2xl mx-auto">
      A showcase of my recent work in web development, from modern Astro sites to custom Contao CMS solutions.
    </p>
  </section>

  <section class="px-4 py-16 max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Project 1 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-brand-secondary to-brand-primary/30"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">E-commerce Platform</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            Modern e-commerce solution built with Astro and Tailwind CSS, featuring fast loading and SEO optimization.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Astro</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Tailwind</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">JavaScript</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Project →</a>
        </div>
      </div>

      <!-- Project 2 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-emerald-900 to-brand-primary/20"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">Contao CMS Extension</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            Custom Contao 5 module for content management with advanced features and clean architecture.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Contao</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">PHP</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">MySQL</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Project →</a>
        </div>
      </div>

      <!-- Project 3 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-rose-900 to-brand-primary/20"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">SEO-Optimized Blog</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            High-performance blog with technical SEO, schema markup, and optimized loading speeds.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Astro</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Tailwind</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">SEO</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Project →</a>
        </div>
      </div>

      <!-- Project 4 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-indigo-900 to-brand-primary/20"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">Corporate Website</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            Professional corporate site with modern design, accessibility compliance, and performance optimization.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Astro</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Tailwind</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">TypeScript</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Project →</a>
        </div>
      </div>

      <!-- Project 5 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-amber-900 to-brand-primary/20"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">API Integration</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            Custom API integrations connecting third-party services with seamless data synchronization.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">PHP</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">REST API</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">JavaScript</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Project →</a>
        </div>
      </div>

      <!-- Project 6 -->
      <div class="group bg-brand-bg border border-brand-border rounded-2xl overflow-hidden hover:border-brand-primary/40 transition">
        <div class="h-48 bg-gradient-to-br from-pink-900 to-brand-primary/20"></div>
        <div class="p-6">
          <h3 class="text-lg font-bold mb-2">Performance Audit</h3>
          <p class="text-brand-muted text-sm mb-4 leading-relaxed">
            Complete website performance optimization resulting in 60% faster loading times and improved SEO scores.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Performance</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">SEO</span>
            <span class="bg-brand-secondary/30 text-brand-primary border border-brand-primary/10 px-2.5 py-1 rounded-md text-xs font-medium">Optimization</span>
          </div>
          <a href="#" class="text-brand-primary text-sm font-medium hover:text-white transition">View Case Study →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="px-4 py-24 bg-brand-surface border-y border-brand-border text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Ready to Start Your Project?</h2>
      <p class="text-brand-muted text-lg mb-10">
        Let's discuss your web development needs and create something amazing together.
      </p>
      <a href="/contact" class="inline-block bg-brand-primary text-white px-10 py-4 rounded-full text-lg font-semibold hover:brightness-110 transition">
        Get In Touch
      </a>
    </div>
  </section>
</BaseLayout>
