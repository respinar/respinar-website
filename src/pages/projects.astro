---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects | Respinar"
  description="Explore my portfolio of web development projects including Astro, Tailwind CSS, and Contao CMS solutions."
>
  <!-- HERO SECTION -->
  <section class="px-4 py-24 max-w-6xl mx-auto text-center">
    <h1 class="text-5xl md:text-6xl font-extrabold leading-tight">
      My Projects
    </h1>
    <p class="text-lg text-gray-600 mt-6 max-w-2xl mx-auto">
      A showcase of my recent work in web development, from modern Astro sites to custom Contao CMS solutions.
    </p>
  </section>

  <!-- PROJECTS GRID -->
  <section class="px-4 py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-4xl font-bold text-center mb-12">Featured Work</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Project 1 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-blue-500 to-purple-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">E-commerce Platform</h3>
            <p class="text-gray-600 mb-4">
              Modern e-commerce solution built with Astro and Tailwind CSS, featuring fast loading and SEO optimization.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">Astro</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">Tailwind CSS</span>
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">JavaScript</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Project →</a>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-green-500 to-teal-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Contao CMS Extension</h3>
            <p class="text-gray-600 mb-4">
              Custom Contao 5 module for content management with advanced features and clean architecture.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded text-sm">Contao CMS</span>
              <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-sm">PHP</span>
              <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">MySQL</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Project →</a>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-red-500 to-pink-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">SEO-Optimized Blog</h3>
            <p class="text-gray-600 mb-4">
              High-performance blog with technical SEO, schema markup, and optimized loading speeds.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">Astro</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">Tailwind CSS</span>
              <span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded text-sm">SEO</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Project →</a>
          </div>
        </div>

        <!-- Project 4 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-indigo-500 to-blue-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Corporate Website</h3>
            <p class="text-gray-600 mb-4">
              Professional corporate site with modern design, accessibility compliance, and performance optimization.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">Astro</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">Tailwind CSS</span>
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded text-sm">TypeScript</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Project →</a>
          </div>
        </div>

        <!-- Project 5 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-yellow-500 to-orange-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">API Integration</h3>
            <p class="text-gray-600 mb-4">
              Custom API integrations connecting third-party services with seamless data synchronization.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded text-sm">PHP</span>
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">REST API</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-sm">JavaScript</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Project →</a>
          </div>
        </div>

        <!-- Project 6 -->
        <div class="bg-white rounded-2xl shadow hover:shadow-lg transition overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-pink-500 to-rose-600"></div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Performance Audit</h3>
            <p class="text-gray-600 mb-4">
              Complete website performance optimization resulting in 60% faster loading times and improved SEO scores.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded text-sm">Performance</span>
              <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded text-sm">SEO</span>
              <span class="bg-red-100 text-red-800 px-2 py-1 rounded text-sm">Optimization</span>
            </div>
            <a href="#" class="text-blue-600 hover:text-blue-800 font-medium">View Case Study →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CALL TO ACTION -->
  <section class="px-4 py-24 bg-blue-600 text-white text-center">
    <h2 class="text-4xl font-bold mb-6">Ready to Start Your Project?</h2>
    <p class="text-lg mb-10 max-w-2xl mx-auto text-blue-100">
      Let's discuss your web development needs and create something amazing together.
    </p>

    <a
      href="/contact"
      class="bg-white text-blue-700 font-semibold px-8 py-4 rounded-xl text-lg hover:bg-blue-100 transition"
    >
      Get In Touch
    </a>
  </section>
</BaseLayout>